# ============================================================
# SecondPlanet Community Edition — environment template
# ============================================================
# Copy this file to .env and fill in the blanks:
#
#     cp .env.example .env
#
# Every secret below is intentionally EMPTY. The stack refuses to start while a
# required secret is missing, so nothing here can ever be shipped by accident.
#
# Generate secrets with:
#     openssl rand -hex 32      # 64 hex characters
#     openssl rand -hex 16      # 32 hex characters
#
# .env is git-ignored. Never commit it.
# ============================================================

# ------------------- public address -------------------
# The address the browser uses. Set this to your own domain before going live;
# it is used for CORS, password reset links and the public object storage URL.
PUBLIC_URL=http://localhost:8080
# Host port of the web server (the API and the database stay internal).
WEB_PORT=8080

# ------------------- database -------------------
MYSQL_DATABASE=secondplanet
MYSQL_USER=secondplanet
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Host port of the database, useful for a local client or for backups.
MYSQL_PORT=3306
# Connection string used by the API. It must use the same database, user and
# password as above, and the host name "mysql" (the Compose service name).
# URL-encode special characters in the password (%40 for @, %2F for /, ...).
DATABASE_URL=

# ------------------- cache and job queue -------------------
# Redis is reachable from the Compose network only. Leave the password empty
# unless you publish the port to the host.
REDIS_PASSWORD=
REDIS_DB=0

# ------------------- object storage -------------------
MINIO_ROOT_USER=secondplanet
MINIO_ROOT_PASSWORD=
# Public bucket (course media) and private bucket (hackathon attachments).
# If you rename a bucket, also update the matching location blocks in
# deploy/nginx.conf — the public URL is signed with the bucket name.
MINIO_BUCKET=secondplanet
MINIO_PRIVATE_BUCKET=secondplanet-private
# Host ports of the S3 API and of the storage console.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------- first boot accounts -------------------
# Created by the one-shot migration job on an empty database.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=
# Set to false to skip the demo seed data entirely.
BOOTSTRAP_DATA=true

# ------------------- authentication -------------------
# 64 hex characters. The API refuses to start with an empty or a short value.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Comma separated list of enabled providers: email_password, oauth.google,
# oauth.github. The OAuth client id/secret are only needed for the providers
# you enable.
AUTH_PROVIDERS=email_password
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URI=
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_REDIRECT_URI=

# ------------------- rate limiting -------------------
# Requests per second / per minute per client. The application defaults are
# 30 and 600 when these are empty.
THROTTLE_SHORT=
THROTTLE_MEDIUM=

# ------------------- AI features -------------------
# Personal AI course generation is off by default. Every AI feature is
# BYOK-only: users configure their own provider key in the app.
AI_PERSONAL_COURSES_ENABLED=false
# Per-user daily BYOK token budget enforced in Redis.
AI_USER_DAILY_BYOK_TOKENS=500000
# Number of AI jobs processed at the same time.
AI_JOB_CONCURRENCY=2
# Redis key prefix of the AI job queue.
AI_JOB_QUEUE_PREFIX=aicourse
# Timeout of a single provider request, in milliseconds.
AI_PROVIDER_TIMEOUT_MS=60000
# 64 hex characters. Required to store a provider API key in the admin console.
AI_KEY_ENCRYPTION_KEY=
# Optional. Without a key the AI features fall back to rule based generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ------------------- email (optional) -------------------
# Both values are needed to enable self-service password reset.
RESEND_API_KEY=
MAIL_FROM=

# ------------------- prebuilt images (optional) -------------------
# By default the API and the web image are built from this checkout.
# Set them to pull the images from a registry instead.
# API_IMAGE=ghcr.io/secondplanet/community-api:latest
# WEB_IMAGE=ghcr.io/secondplanet/community-web:latest

# ------------------- frontend branding (optional) -------------------
# These are baked into the web image at build time.
# VITE_PUBLIC_PLATFORM_NAME=SecondPlanet
# VITE_PUBLIC_CONTACT_EMAIL=
# VITE_ICP=
