// ==================== 学习进度 ====================
model ProgressRecord {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  courseId     String         @map("course_id")
  lessonId     String         @map("lesson_id")
  status       ProgressStatus @default(not_started)
  completedAt  DateTime?      @map("completed_at")
  lastPosition Int?           @map("last_position")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([courseId, status])
  @@index([lessonId])
  @@index([userId, status])
  @@index([status, completedAt])
  @@map("progress_records")
}

enum ProgressStatus {
  not_started
  in_progress
  completed
}

// ==================== 实践项目 ====================
model PracticeProject {
  id            String            @id @default(uuid())
  courseId      String            @map("course_id")
  title         String
  description   String            @db.Text
  projectUrl    String            @map("project_url")
  thumbnailUrl  String?           @map("thumbnail_url")
  difficulty    ProjectDifficulty @default(intermediate)
  estimatedTime Int               @default(30) @map("estimated_time") // 分钟
  tags          String?           @db.Text // 逗号分隔
  projectType   ProjectType       @map("project_type")
  orderIndex    Int               @default(0) @map("order_index")
  requirements  String?           @db.Text // 前置要求
  objectives    String?           @db.Text // 学习目标
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions PracticeCompletion[]

  @@index([courseId, isActive, orderIndex])
  @@map("practice_projects")
}

enum ProjectDifficulty {
  beginner
  intermediate
  advanced
  expert
}

enum ProjectType {
  model_deployment // 模型部署
  model_training // 模型训练
  model_inference // 模型推理
  api_integration // API集成
  notebook // Jupyter Notebook
  sandbox // 在线沙箱
  repository // 代码仓库
  csghub_space // CSGHub Space
}

model PracticeCompletion {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  projectId     String           @map("project_id")
  status        CompletionStatus @default(in_progress)
  startedAt     DateTime         @default(now()) @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  submissionUrl String?          @map("submission_url") // 用户提交的链接（可选）
  notes         String?          @db.Text // 学习笔记
  // 软删：admin 清账号 / 用户撤回进度走 deletedAt
  deletedAt     DateTime?        @map("deleted_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project PracticeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("practice_completions")
}

enum CompletionStatus {
  in_progress
  completed
  skipped
}

// ==================== 游戏化：成就徽章 ====================
model Badge {
  id            String            @id @default(uuid())
  code          String            @unique // 程序内唯一标识，如 "first_course"
  name          String
  description   String            @db.Text
  icon          String            @default("award") // lucide 图标名
  category      String            @default("general") // 分组：learning / streak / milestone ...
  criteriaType  BadgeCriteriaType @map("criteria_type")
  criteriaValue Int               @default(1) @map("criteria_value") // 达成阈值
  // P1-3 嵌套规则 DSL(JSON 树,支持 AND/OR/NOT 组合)
  // 为 null 时 fallback 到 criteriaType + criteriaValue
  criteriaJson  Json?             @map("criteria_json")
  points        Int               @default(0) // 解锁奖励积分
  isActive      Boolean           @default(true) @map("is_active")
  orderIndex    Int               @default(0) @map("order_index")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@map("badges")
}

enum BadgeCriteriaType {
  course_completed // 完成 N 门课程
  lessons_completed // 累计完成 N 个课时
  streak_days // 连续学习 N 天
  first_enrollment // 首次报名（N=1）
  practice_completed // 完成 N 个实践项目
  points_reached // 累计积分达到 N
  // P1 修复(2026-07-24): 完成指定 courseId 的课程 (叶子 criteriaJson.courseId, target 默认为 1)
  course_specific
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeId    String   @map("badge_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ==================== 游戏化：积分流水 ====================
model PointTransaction {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  amount    Int // 正数为获得，负数为扣除
  reason    String // 人类可读原因，如 "完成课时"
  // P2-2: 关联类型: lesson / practice / badge / enrollment (从 String 升级为 enum)
  refType   PointRefType? @map("ref_type")
  refId     String?       @map("ref_id") // 关联实体 ID，用于幂等去重
  // 软删：金融痕迹永久保留, 走 deletedAt (修正错账 / 退积分)
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refType, refId]) // 同一来源不重复发放
  @@index([userId, createdAt])
  @@index([userId, deletedAt])
  @@map("point_transactions")
}

// ==================== 课程评价（P1-3）=============
// 一个 user 对一门课只允许一条评价（@@unique 强制）
// rating: 1-5 整数；helpful: 累计被点赞数（append-only counter）
model Review {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  courseId  String    @map("course_id")
  rating    Int // 1-5
  content   String    @db.Text
  helpful   Int       @default(0)
  // 软删：admin 下架违规评价走 deletedAt (保留作者 / 评分痕迹, 详情页过滤)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpful[]

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
  @@index([courseId, helpful])
  @@index([courseId, deletedAt])
  @@map("reviews")
}

model ReviewHelpful {
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId, createdAt])
  @@map("review_helpful_votes")
}

model Note {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  content     String   @db.Text
  positionSec Int?     @map("position_sec")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId, positionSec])
  @@map("notes")
}

// ==================== 通知中心（P1-7）====================
// 站内通知：评论 / 报名 / 黑客松 / 系统 等
// 4 类:type = 'announcement' | 'comment' | 'hackathon' | 'order'
//   - announcement: 系统公告 / 课程更新
//   - comment:      评论 @ 提及 / 讲师回复
//   - hackathon:    黑客松截止提醒 / 评审结果
//   - order:        订单支付成功 / 退款
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  // P2-2: 4 类之一 (从 String 升级为 enum)
  type      NotificationKind
  title     String
  body      String           @db.Text
  linkUrl   String?          @map("link_url")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  deletedAt DateTime?        @map("deleted_at") // 软删
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@map("notifications")
}

enum NotificationType {
  announcement
  comment
  hackathon
  order
}

// ==================== AI 自建课程 ====================

model LearningProject {
  id                String                @id @default(uuid())
  userId            String                @map("user_id")
  courseId          String                @unique @map("course_id")
  createRequestKey  String                @map("create_request_key")
  seedType          LearningSeedType      @default(question) @map("seed_type")
  seedText          String                @map("seed_text") @db.Text
  learningGoal      String?               @map("learning_goal") @db.Text
  targetLevel       CourseLevel?          @map("target_level")
  availableMinutes  Int?                  @map("available_minutes")
  preferences       Json?
  planSnapshot      Json?                 @map("plan_snapshot")
  status            LearningProjectStatus @default(planning)
  currentStep       String?               @map("current_step")
  progressPercent   Int                   @default(0) @map("progress_percent")
  activeLessonId    String?               @map("active_lesson_id")
  activeBlockId     String?               @map("active_block_id")
  activeBlockOffset Int?                  @map("active_block_offset")
  lastAccessedAt    DateTime?             @map("last_accessed_at")
  planVersion       Int                   @default(0) @map("plan_version")
  planApprovedAt    DateTime?             @map("plan_approved_at")
  lastErrorCode     String?               @map("last_error_code")
  lastErrorMessage  String?               @map("last_error_message") @db.Text
  archivedAt        DateTime?             @map("archived_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activeLesson   Lesson?           @relation("ActiveProjectLesson", fields: [activeLessonId], references: [id], onDelete: SetNull)
  jobs           AiGenerationJob[]
  assessments    Assessment[]
  lessonVariants LessonVariant[]
  chatSessions   ChatSession[]

  @@unique([userId, createRequestKey])
  @@index([userId, status, updatedAt])
  @@index([userId, status, lastAccessedAt, id], map: "learning_projects_hub_cursor_idx")
  @@map("learning_projects")
}

model LessonContent {
  id             String              @id @default(uuid())
  lessonId       String              @unique @map("lesson_id")
  status         LessonContentStatus @default(empty)
  schemaVersion  Int                 @default(1) @map("schema_version")
  version        Int                 @default(1)
  blocks         Json?
  summary        String?             @db.Text
  glossary       Json?
  sourceMode     String              @default("model_knowledge") @map("source_mode")
  generationNote String?             @map("generation_note") @db.Text
  generatedAt    DateTime?           @map("generated_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("lesson_contents")
}

model LessonVariant {
  id                   String   @id @default(uuid())
  projectId            String   @map("project_id")
  lessonId             String   @map("lesson_id")
  lessonContentVersion Int      @map("lesson_content_version")
  blockId              String?  @map("block_id")
  action               String
  content              Json?
  jobId                String?  @unique @map("job_id")
  createdAt            DateTime @default(now()) @map("created_at")

  project LearningProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lesson  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  job     AiGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([projectId, lessonId, lessonContentVersion, createdAt])
  @@map("lesson_variants")
}

model CourseConcept {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  key         String
  title       String
  description String?  @db.Text
  orderIndex  Int      @default(0) @map("order_index")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  masteryStates LearnerConceptState[]
  lessonLinks   LessonConcept[]

  @@unique([courseId, key])
  @@index([courseId, orderIndex])
  @@map("course_concepts")
}

model LessonConcept {
  lessonId   String @map("lesson_id")
  conceptId  String @map("concept_id")
  orderIndex Int    @default(0) @map("order_index")

  lesson  Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept CourseConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([lessonId, conceptId])
  @@index([conceptId])
  @@map("lesson_concepts")
}

model LearnerConceptState {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  conceptId     String       @map("concept_id")
  stage         MasteryStage @default(unseen)
  score         Int          @default(0)
  evidenceCount Int          @default(0) @map("evidence_count")
  lastEvidence  Json?        @map("last_evidence")
  nextReviewAt  DateTime?    @map("next_review_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept CourseConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, stage, updatedAt])
  @@map("learner_concept_states")
}

model Assessment {
  id                   String           @id @default(uuid())
  projectId            String           @map("project_id")
  lessonId             String           @map("lesson_id")
  kind                 AssessmentKind
  status               AssessmentStatus @default(generating)
  lessonContentVersion Int              @map("lesson_content_version")
  schemaVersion        Int              @default(1) @map("schema_version")
  questions            Json?
  errorCode            String?          @map("error_code")
  createdAt            DateTime         @default(now()) @map("created_at")

  project  LearningProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lesson   Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts AssessmentAttempt[]

  @@unique([projectId, lessonId, kind, lessonContentVersion])
  @@index([projectId, status, createdAt])
  @@map("assessments")
}

model AssessmentAttempt {
  id                  String                  @id @default(uuid())
  assessmentId        String                  @map("assessment_id")
  userId              String                  @map("user_id")
  status              AssessmentAttemptStatus @default(pending)
  clientSubmissionKey String                  @map("client_submission_key")
  answers             Json
  grading             Json?
  score               Int?
  recommendation      Json?
  submittedAt         DateTime                @default(now()) @map("submitted_at")
  gradedAt            DateTime?               @map("graded_at")
  errorCode           String?                 @map("error_code")

  assessment  Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradingJobs AiGenerationJob[]

  @@unique([assessmentId, userId, clientSubmissionKey])
  @@index([userId, submittedAt])
  @@index([assessmentId, status, submittedAt])
  @@map("assessment_attempts")
}

model AiGenerationJob {
  id                        String          @id @default(uuid())
  userId                    String          @map("user_id")
  projectId                 String          @map("project_id")
  lessonId                  String?         @map("lesson_id")
  attemptId                 String?         @map("attempt_id")
  parentJobId               String?         @map("parent_job_id")
  type                      AiJobType
  status                    AiJobStatus     @default(queued)
  enqueueStatus             AiEnqueueStatus @default(pending) @map("enqueue_status")
  requestKey                String          @map("request_key")
  executionNo               Int             @default(1) @map("execution_no")
  inputHash                 String          @map("input_hash")
  targetVersion             Int?            @map("target_version")
  progress                  Int             @default(0)
  currentStep               String?         @map("current_step")
  queueAttempts             Int             @default(0) @map("queue_attempts")
  manualRetries             Int             @default(0) @map("manual_retries")
  nextEnqueueAt             DateTime?       @map("next_enqueue_at")
  enqueueLeaseOwner         String?         @map("enqueue_lease_owner")
  enqueueLeaseExpiresAt     DateTime?       @map("enqueue_lease_expires_at")
  executionLeaseOwner       String?         @map("execution_lease_owner")
  executionLeaseExpiresAt   DateTime?       @map("execution_lease_expires_at")
  heartbeatAt               DateTime?       @map("heartbeat_at")
  cancelRequestedAt         DateTime?       @map("cancel_requested_at")
  providerRequestStartedAt  DateTime?       @map("provider_request_started_at")
  providerRequestDeadlineAt DateTime?       @map("provider_request_deadline_at")
  providerRequestFinishedAt DateTime?       @map("provider_request_finished_at")
  errorCode                 String?         @map("error_code")
  errorMessage              String?         @map("error_message") @db.Text
  resultRef                 Json?           @map("result_ref")
  startedAt                 DateTime?       @map("started_at")
  finishedAt                DateTime?       @map("finished_at")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         LearningProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lesson          Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempt         AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  parentJob       AiGenerationJob?   @relation("JobRetries", fields: [parentJobId], references: [id], onDelete: SetNull)
  retryExecutions AiGenerationJob[]  @relation("JobRetries")
  variants        LessonVariant[]

  @@unique([requestKey, executionNo])
  @@index([projectId, status, createdAt])
  @@index([enqueueStatus, nextEnqueueAt])
  @@index([enqueueStatus, enqueueLeaseExpiresAt], map: "ai_jobs_enqueue_lease_idx")
  @@index([status, executionLeaseExpiresAt], map: "ai_jobs_execution_lease_idx")
  @@index([status, providerRequestDeadlineAt], map: "ai_jobs_provider_deadline_idx")
  @@index([status, createdAt])
  @@map("ai_generation_jobs")
}

// ==================== P2: AI 助教 / 学情事件 ====================
// 详见 review/redesign-spec.md §6.1

model ChatSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  lessonId  String?   @map("lesson_id")
  courseId  String?   @map("course_id")
  projectId String?   @map("project_id")
  scope     ChatScope @default(general)
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  course   Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  project  LearningProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, lessonId])
  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([courseId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  // P2-2: 'user' | 'assistant' | 'system' (从 String 升级为 enum)
  role      ChatRole
  content   String   @db.Text
  // mock 阶段每条 100 tokens,P2 切真 AI 时改用 tokensIn / tokensOut
  tokens    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum ChatMessageRole {
  user
  assistant
  system
}

model LearningEvent {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  lessonId    String?           @map("lesson_id")
  // P2-2: 'play' | 'pause' | 'seek' | 'complete' | 'replay' | 'skip' | 'note' (从 String 升级为 enum)
  eventType   LearningEventType @map("event_type")
  positionSec Int?              @map("position_sec")
  durationMs  Int?              @map("duration_ms")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([lessonId, eventType])
  @@map("learning_events")
}

// 用户自己的 AI 接入配置。apiKey 只在服务端加密保存，接口只返回掩码。
model UserAiProviderConfig {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  provider        String
  apiKeyEnc       String    @map("api_key_enc") @db.Text
  model           String
  baseUrl         String?   @map("base_url")
  isActive        Boolean   @default(true) @map("is_active")
  verifiedAt      DateTime? @map("verified_at")
  lastVerifyError String?   @map("last_verify_error") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, isActive])
  @@map("user_ai_provider_configs")
}

// 注: Review model 已在 P1-3 评价系统 (line 700 附近) 完整定义, 这里不重复.
// 之前 dev DB 的 reviews 表跟 schema 重复, 但 prisma migrate deploy 会处理 (用 P1-3 那一份).

// ==================== P1-3 评价: 完整 Review model 已合并, 这里是 P2 chat/learning event 附加 ====================

// ==================== CMS 基础设施 (2026-07-21) ====================
// 把所有 UI 硬编码 (文案 / 列表 / enum label / 业务规则) 迁到后台可配置
// 见 review/cms-design.md §1 schema 约定

// §1.1 核心 3 张表

// 全局 key-value 配置 (duration_buckets / number_format / ai.quick_prompts 等)
model AppSetting {
  key         String          @id
  valueJson   Json            @map("value_json")
  scope       AppSettingScope @default(global)
  description String?         @db.Text
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("app_settings")
}

// 枚举 i18n (label + color + icon), 组合主键 (enumType, enumValue, locale)
model EnumTranslation {
  enumType   String  @map("enum_type")
  enumValue  String  @map("enum_value")
  locale     String  @default("zh-CN")
  label      String
  colorClass String? @map("color_class")
  icon       String?
  sortOrder  Int     @default(0) @map("sort_order")

  @@id([enumType, enumValue, locale])
  @@index([enumType, locale])
  @@map("enum_translations")
}

// 日期/时间格式模板
model DateFormatTemplate {
  scope    DateFormatTemplateScope
  locale   String                  @default("zh-CN")
  template String

  @@id([scope, locale])
  @@map("date_format_templates")
}

// §1.2 品牌文案 2 张

// 全局品牌文案 (hero / footer / auth shell / nav)
model SiteSetting {
  key         String           @id
  value       Json
  scope       SiteSettingScope @default(global)
  description String?          @db.Text
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("site_settings")
}

// 页面级文案 (按路由)
model PageSetting {
  page        String
  key         String
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([page, key])
  @@index([page])
  @@map("page_settings")
}

// §1.3 结构化列表 10 张

// 学员故事 / 证言
model Testimonial {
  id         String  @id @default(cuid())
  name       String
  title      String
  quote      String  @db.Text
  avatar     String?
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  @@index([isActive, orderIndex])
  @@map("testimonials")
}

// AI 快捷 prompt (dashboard 助手 / lesson 内)
model QuickPrompt {
  id         String           @id @default(cuid())
  emoji      String           @default("💡")
  label      String
  promptText String           @map("prompt_text") @db.Text
  scope      QuickPromptScope @default(lesson)
  isActive   Boolean          @default(true) @map("is_active")
  orderIndex Int              @default(0) @map("order_index")

  @@index([isActive, orderIndex])
  @@index([scope, isActive, orderIndex])
  @@map("quick_prompts")
}

// 课程分类 (LLM 应用 / RAG / Agent / ...)
model CourseCategory {
  id         String  @id @default(cuid())
  key        String  @unique
  label      String
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  // P1 修复(2026-07-24): 反向 relation
  courses Course[]

  @@index([isActive, orderIndex])
  @@map("course_categories")
}

// 热门搜索词 (含点击数)
model PopularSearch {
  id         String  @id @default(cuid())
  keyword    String  @unique
  clickCount Int     @default(0) @map("click_count")
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  @@index([isActive, orderIndex])
  @@map("popular_searches")
}

// 热词 (按 scope: courses / home / search)
model HotKeyword {
  id         String          @id @default(cuid())
  keyword    String          @unique
  scope      HotKeywordScope @default(courses)
  isActive   Boolean         @default(true) @map("is_active")
  orderIndex Int             @default(0) @map("order_index")

  @@index([scope, isActive, orderIndex])
  @@map("hot_keywords")
}

// 第三方登录 provider (Google / GitHub / 微信 / ...)
model AuthProvider {
  id         String  @id
  label      String
  icon       String
  isActive   Boolean @default(false) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")
  config     Json?

  @@index([isActive, orderIndex])
  @@map("auth_providers")
}

// 顶部导航项
model TopNavItem {
  id         String  @id @default(cuid())
  label      String
  path       String
  icon       String?
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  @@index([isActive, orderIndex])
  @@map("top_nav_items")
}

// Footer 列
model FooterColumn {
  id         String  @id @default(cuid())
  title      String
  links      Json
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  @@index([isActive, orderIndex])
  @@map("footer_columns")
}

// §1.4 i18n 1 张

// 通用文案 (key 模式, 按 locale)
model I18nMessage {
  key      String       @db.VarChar(255)
  locale   String       @default("zh-CN")
  value    String       @db.Text
  // P2-2: 分类 (从 String 升级为 enum)
  // 现有 seed-cms.ts 用了 'empty'/'loading'/'error'/'toast' 旧值,
  // prisma db push 前需要先 SQL 修正为新 enum 值 (默认 'common')
  category I18nCategory @default(common)

  @@id([key, locale])
  @@index([category])
  @@map("i18n_messages")
}

enum I18nMessageCategory {
  common
  auth
  course
  hackathon
  degree
  admin
}
