generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户与权限 ====================
model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  name                  String
  role                  UserRole  @default(student)
  avatarUrl             String?   @map("avatar_url")
  passwordResetRequired Boolean   @default(false) @map("password_reset_required")
  points                Int       @default(0)
  level                 Int       @default(1)
  // 软删：admin 禁用账号走 deletedAt, user 物理删除会触发 17 个外键 cascade (证书 / 积分 / 评价 / 进度 ...) 数据断裂
  // Service 层 (users.service.ts) 禁调 prisma.user.delete, 只能 update({ deletedAt: now() })
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  lastLoginAt           DateTime? @map("last_login_at")

  refreshTokens         RefreshToken[]
  providerAccounts      UserProviderAccount[]
  passwordResetTokens   PasswordResetToken[]
  enrollments           Enrollment[]
  orders                Order[]
  progressRecords       ProgressRecord[]
  teamMembers           TeamMember[]
  hackathonRegs         HackathonRegistration[]
  reviewedHackathonRegs HackathonRegistration[] @relation("HackathonRegistrationReviewer")
  submissions           Submission[]
  practiceCompletions   PracticeCompletion[]
  userBadges            UserBadge[]
  pointTransactions     PointTransaction[]
  organizedHackathons   Hackathon[]             @relation("OrganizedHackathons")
  reviews               Review[]
  reviewHelpfulVotes    ReviewHelpful[]
  notes                 Note[]
  notifications         Notification[]
  // P1-8: 证书（学位 / 课程 / 黑客松完成时签发）
  certificates          Certificate[]
  // P2: 新增关联 (chat / learning events / AI usage)
  chatSessions          ChatSession[]
  learningEvents        LearningEvent[]
  aiProviderConfigs     UserAiProviderConfig[]
  ownedCourses          Course[]                @relation("OwnedCourses")
  learningProjects      LearningProject[]
  masteryStates         LearnerConceptState[]
  assessmentAttempts    AssessmentAttempt[]
  aiGenerationJobs      AiGenerationJob[]

  @@index([email, deletedAt])
  @@index([role, deletedAt])
  @@map("users")
}

// ==================== 证书（P1-8）====================
// 三类签发:course(单课程) / degree(学位) / hackathon(黑客松获奖)
// serial 格式: OCSG-{YEAR}-{TYPE}-{4位序号}, 全表 unique
// revokedAt 非空表示已撤销(管理员操作), 公开 verify 接口会查
// metadata 装 JSON(评分 / 排名 / 备注等扩展信息)
model Certificate {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  // P2-2: 'course' | 'degree' | 'hackathon' (从 String 升级为 enum)
  type         CertificateType
  // 关联的 course / degree / hackathon id
  refId        String          @map("ref_id")
  title        String
  description  String?         @db.Text
  // 证书编号 (e.g. "OCSG-2026-COURSE-0001")
  serialNumber String          @unique @map("serial_number")
  issuedAt     DateTime        @default(now()) @map("issued_at")
  // 课程 / 学位 / 黑客松完成时间
  completedAt  DateTime        @map("completed_at")
  // 证书图片 URL (mock: 静态占位)
  imageUrl     String?         @map("image_url")
  // 公开可验证 URL
  verifyUrl    String?         @map("verify_url")
  // 元数据: 评分 / 排名 / 备注
  metadata     Json?
  revokedAt    DateTime?       @map("revoked_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([refId, type])
  @@index([serialNumber])
  @@map("certificates")
}

enum CertificateType {
  course
  degree
  hackathon
}

enum UserRole {
  admin
  student
  instructor
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

// ==================== Auth 抽象层 - 多 Provider 绑定 ====================
// 一个 user 可绑定多个 provider 账号（email/password + 第三方 OAuth ...）
// 设计目标：可插拔 + 配置驱动 + 不重复造轮子
//
// P2 扩展：显式字段（email / displayName / isPrimary / linkedAt / lastUsedAt / deletedAt）
// 原本只在 profile JSON 里有,前端 BindingsPage / admin / 风控都需要显式列
// → 加列, 旧数据由 migration 回填 (从 profile JSON 解析 + createdAt → linkedAt, updatedAt → lastUsedAt)
model UserProviderAccount {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  // provider 标识,如 "email_password" / "oauth.google"
  // 用 String 而非 enum,新增 provider 不需要改 schema + 不需要 migration
  provider       String
  // 该 provider 内部的 user id（email / oauth sub）
  providerUserId String @map("provider_user_id")

  // ---- P2 新增显式字段 ----
  // 第三方 profile 拉到的 email（即使本表 user.email 不一致,也保留第三方侧的）
  email       String?
  // 第三方 profile 拉到的显示名
  displayName String?   @map("display_name")
  // 是否为该 user 的主登录方式（解绑时不允许删主身份）
  isPrimary   Boolean   @default(false) @map("is_primary")
  // 绑定时间（原 createdAt 的语义迁移,数据回填用）
  linkedAt    DateTime  @default(now()) @map("linked_at")
  // 最后使用时间（原 updatedAt 的语义迁移）
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  // 软删时间（P2：解绑走软删,保留审计可追溯）
  deletedAt   DateTime? @map("deleted_at")

  // 原始 profile / claims JSON,留作 audit + 后续扩展
  profile   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([userId, deletedAt])
  @@map("user_provider_accounts")
}

// ==================== 课程结构 ====================
model Course {
  id             String           @id @default(uuid())
  title          String
  description    String           @db.Text
  learningPoints String           @map("learning_points") @db.Text
  instructor     String
  level          CourseLevel
  duration       String
  thumbnail      String
  tags           String           @db.Text
  costType       CostType         @map("cost_type")
  price          Decimal          @default(0) @db.Decimal(10, 2)
  status         CourseStatus     @default(draft)
  courseType     CourseType       @default(own) @map("course_type")
  externalUrl    String?          @map("external_url")
  sourceVideoUrl String?          @unique @map("source_video_url")
  sourcePlatform String?          @map("source_platform")
  ownerUserId    String?          @map("owner_user_id")
  origin         CourseOrigin     @default(platform)
  visibility     CourseVisibility @default(public)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  chapters         Chapter[]
  enrollments      Enrollment[]
  orders           Order[]
  progressRecords  ProgressRecord[]
  degreeCourses    DegreeCourse[]
  practiceProjects PracticeProject[]
  reviews          Review[]
  // 2026-07-24: 讲师/导师多对多 (替代死字段 instructorId)
  courseLinks      CourseInstructorLink[]
  category         CourseCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?                @map("category_id")
  owner            User?                  @relation("OwnedCourses", fields: [ownerUserId], references: [id], onDelete: Restrict)
  learningProject  LearningProject?
  concepts         CourseConcept[]
  chatSessions     ChatSession[]

  @@index([status, createdAt])
  @@index([costType])
  @@index([courseType])
  @@index([level])
  @@index([createdAt])
  @@index([categoryId])
  @@index([ownerUserId, origin, createdAt])
  @@index([visibility, status, createdAt])
  @@map("courses")
}

enum CourseLevel {
  Beginner
  Intermediate
  Advanced
  Expert
}

enum CostType {
  free
  paid
  charity
}

enum CourseStatus {
  draft
  published
  archived
}

enum CourseOrigin {
  platform
  ai_personal
}

enum CourseVisibility {
  public
  private
  unlisted
}

enum CourseType {
  own // 自有课程
  partner // 合作课程
  public // 公开课程
  third_party // 第三方课程
}

model Chapter {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  title       String
  description String?   @db.Text
  orderIndex  Int       @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  // P2: 软删 — admin 端点删章节走软删,前端 / 用户进度仍能查到
  deletedAt   DateTime? @map("deleted_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, deletedAt])
  @@map("chapters")
}

model Lesson {
  id               String    @id @default(uuid())
  chapterId        String    @map("chapter_id")
  title            String
  description      String?   @db.Text
  videoUrl         String?   @map("video_url")
  videoDuration    Int?      @map("video_duration")
  orderIndex       Int       @map("order_index")
  isPreview        Boolean   @default(false) @map("is_preview")
  estimatedMinutes Int       @default(10) @map("estimated_minutes")
  isHidden         Boolean   @default(false) @map("is_hidden")
  createdAt        DateTime  @default(now()) @map("created_at")
  // P2: 软删
  deletedAt        DateTime? @map("deleted_at")

  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  resources        Resource[]
  progress         ProgressRecord[]
  // P2 关联
  learningEvents   LearningEvent[]
  chatSessions     ChatSession[]
  notes            Note[]
  activeProjects   LearningProject[] @relation("ActiveProjectLesson")
  content          LessonContent?
  conceptLinks     LessonConcept[]
  assessments      Assessment[]
  aiGenerationJobs AiGenerationJob[]
  variants         LessonVariant[]

  @@index([chapterId, deletedAt])
  @@map("lessons")
}

model Resource {
  id        String       @id @default(uuid())
  lessonId  String       @map("lesson_id")
  title     String
  url       String
  type      ResourceType
  isLocked  Boolean      @default(true) @map("is_locked")
  createdAt DateTime     @default(now()) @map("created_at")
  // P2: 软删
  deletedAt DateTime?    @map("deleted_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, deletedAt])
  @@map("resources")
}

enum ResourceType {
  pdf
  code
  link
  video
  audio
}

// ==================== 讲师 / 导师 (2026-07-24) ====================
// 设计: 独立表, 不挂 User; 管理员后台统一维护
// 讲师/导师同一表, 课程通过多对多联表 CourseInstructorLink 挂载, 带 role + isPrimary
// 字段命名: 中文为主源 (zh), 英文/拼音别名为可选 (nameEn / titleEn / headlineEn / bioEn)
// 多语言: per-entity 自由文本直接放表列 (中英双语), 不走 i18n_messages (key-value 不适合 per-entity)
// publishedAt 软发布: null = 草稿态, 前台不显示; admin 手动设置才进前台
// 注意: id 用 cuid() 而非 uuid() (跟 Order 一致, 自增可读性更好)

model Instructor {
  id                String    @id @default(cuid())
  // URL slug, /instructors/{slug}, 唯一, 拼音+hash 兜底, admin 可改
  slug              String    @unique
  // 中文主显示名 (主源)
  name              String
  // 英文/拼音别名 (可选)
  nameEn            String?   @map("name_en")
  // 头衔: "首席科学家" / "AI 工程师" / "清华教授" (自由文本, 不做 enum, 长度限制 120)
  title             String?   @db.VarChar(120)
  titleEn           String?   @map("title_en") @db.VarChar(120)
  // 短标语 (一句话简介, 首页讲师卡 / 列表摘要用)
  headline          String?   @db.VarChar(255)
  headlineEn        String?   @map("headline_en") @db.VarChar(255)
  // 长 bio, 富文本存 markdown
  bio               String?   @db.Text
  bioEn             String?   @map("bio_en") @db.Text
  // 头像 URL
  avatarUrl         String?   @map("avatar_url")
  // 当前就职公司
  company           String?   @db.VarChar(120)
  // 从业年限 (int)
  yearsOfExperience Int?      @map("years_of_experience")
  // 社交链接
  linkedinUrl       String?   @map("linkedin_url")
  githubUrl         String?   @map("github_url")
  twitterUrl        String?   @map("twitter_url")
  websiteUrl        String?   @map("website_url")
  // 联系邮箱 (admin 可见, 前台不暴露)
  contactEmail      String?   @map("contact_email")
  // 内部备注 (admin 抽屉)
  notes             String?   @db.Text
  // 排序: 拖拽改值, 前台讲师墙/讲师列表按此升序
  orderIndex        Int       @default(0) @map("order_index")
  // 发布态: null = 草稿 (前台不显示), 否则取发布时间
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  courseLinks    CourseInstructorLink[]
  expertiseLinks InstructorExpertiseLink[]

  @@index([publishedAt, orderIndex])
  @@index([name])
  @@map("instructors")
}

// 课程-讲师 多对多联表
// 同一课程可有 主讲师(instructor) + 导师(mentor), 通过 role 区分
// 助教(co_instructor) 不做, 跟 instructor 合并 (UI 上统一叫"讲师")
// isPrimary: 该课程主讲师标记, 前台课程详情默认显示, 最多 1 个
// Service 层强制: 同一 (courseId, role) 最多 1 个 isPrimary=true
model CourseInstructorLink {
  id           String               @id @default(cuid())
  courseId     String               @map("course_id")
  instructorId String               @map("instructor_id")
  // role i18n label 走 enum_translations(enumType='instructor_role')
  role         CourseInstructorRole @default(instructor)
  isPrimary    Boolean              @default(false) @map("is_primary")
  // 同 role 内的展示顺序
  orderIndex   Int                  @default(0) @map("order_index")
  createdAt    DateTime             @default(now()) @map("created_at")

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([courseId, instructorId, role])
  @@index([instructorId, role])
  @@index([courseId, isPrimary])
  @@map("course_instructor_links")
}

enum CourseInstructorRole {
  instructor
  mentor
}

// 专长 (AI / LLM / RAG / Agent / 编程教学 ...), 独立表 + 联表 (参考 course_category 模式)
// admin 后台管理, key 是程序内英文标识, label 是显示名
model InstructorExpertise {
  id         String   @id @default(cuid())
  // 程序内唯一标识 (admin 后台英文 key), 前端不展示
  key        String   @unique
  // 中文 label (主源)
  label      String
  // 英文 label (可选, 前端按 locale 切换)
  labelEn    String?  @map("label_en")
  // 上下架
  isActive   Boolean  @default(true) @map("is_active")
  // 列表排序
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  instructorLinks InstructorExpertiseLink[]

  @@index([isActive, orderIndex])
  @@map("instructor_expertises")
}

model InstructorExpertiseLink {
  instructorId String @map("instructor_id")
  expertiseId  String @map("expertise_id")
  orderIndex   Int    @default(0) @map("order_index")

  instructor Instructor          @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  expertise  InstructorExpertise @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@id([instructorId, expertiseId])
  @@index([expertiseId])
  @@map("instructor_expertise_links")
}

// ==================== 学位 ====================
model NanoDegree {
  id             String       @id @default(uuid())
  title          String
  description    String       @db.Text
  learningPoints String       @map("learning_points") @db.Text
  price          Decimal      @db.Decimal(10, 2)
  icon           String       @default("sparkles")
  costType       CostType     @map("cost_type")
  thumbnail      String?
  status         CourseStatus @default(draft)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  courses     DegreeCourse[]
  enrollments Enrollment[]
  orders      Order[]

  @@map("nano_degrees")
}

model DegreeCourse {
  degreeId   String @map("degree_id")
  courseId   String @map("course_id")
  orderIndex Int    @default(0) @map("order_index")

  degree NanoDegree @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([degreeId, courseId])
  @@index([courseId])
  @@map("degree_courses")
}

// ==================== 注册与权限 ====================
model Enrollment {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  courseId   String?          @map("course_id")
  degreeId   String?          @map("degree_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  expiresAt  DateTime?        @map("expires_at")
  source     EnrollmentSource @default(direct)
  // 软删：admin 取消报名走 deletedAt (退课 / 批量清账号)
  deletedAt  DateTime?        @map("deleted_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  degree NanoDegree? @relation(fields: [degreeId], references: [id], onDelete: SetNull)

  // 软删后重新报名由 Service 使用 upsert 恢复同一条唯一记录。
  @@unique([userId, courseId])
  @@unique([userId, degreeId])
  @@index([userId, deletedAt])
  @@index([courseId, deletedAt])
  @@map("enrollments")
}

enum EnrollmentSource {
  direct
  degree
  hackathon
  promotion
  order
}

// ==================== 订单与支付 ====================
model Order {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  type          OrderType
  courseId      String?        @map("course_id")
  degreeId      String?        @map("degree_id")
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("CNY")
  status        OrderStatus    @default(pending)
  // P2-2: 'wechat' | 'alipay' | 'stripe' (从 String 升级为 enum)
  // 注意: dev DB 历史数据可能含 'mock_alipay' (测试用),需要先 SQL 修正
  paymentMethod PaymentMethod? @map("payment_method")
  transactionId String?        @map("transaction_id")
  paidAt        DateTime?      @map("paid_at")
  // 软删：财务痕迹 (订单/退款/对账) 永久保留, 走 deletedAt
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  degree NanoDegree? @relation(fields: [degreeId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, paidAt])
  @@index([transactionId])
  @@map("orders")
}

enum OrderType {
  course
  degree
}

enum OrderStatus {
  pending
  paid
  failed
  expired
  refunded
}

enum PaymentMethod {
  wechat
  alipay
  stripe
}

// ==================== 黑客松 ====================
model Hackathon {
  id                     String           @id @default(uuid())
  title                  String
  description            String           @db.Text
  bannerUrl              String?          @map("banner_url")
  status                 HackathonStatus  @default(upcoming)
  startDate              DateTime         @map("start_date")
  endDate                DateTime         @map("end_date")
  registerDeadline       DateTime?        @map("register_deadline")
  submissionDeadline     DateTime?        @map("submission_deadline")
  maxTeamSize            Int              @default(5) @map("max_team_size")
  minTeamSize            Int              @default(1) @map("min_team_size")
  location               String?
  rules                  String?          @db.Text
  submissionRequirements String?          @map("submission_requirements") @db.Text
  prizes                 String?          @db.Text
  // 外部 CTA 链接(基础信息在 tab 里, 详情页只挂 1 个外链: 报名 / 了解更多)
  registrationUrl        String?          @map("registration_url")
  registrationLabel      String?          @map("registration_label")
  registrationMode       RegistrationMode @default(internal) @map("registration_mode")
  registrationFields     Json?            @map("registration_fields")
  organizerId            String?          @map("organizer_id")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  registrations HackathonRegistration[]
  teams         Team[]
  judges        Judge[]
  submissions   Submission[]
  announcements Announcement[]
  // P1 修复(2026-07-24): 赞助商
  sponsors      Sponsor[]
  organizer     User?                   @relation("OrganizedHackathons", fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([status, startDate])
  @@index([organizerId])
  @@map("hackathons")
}

enum HackathonStatus {
  upcoming
  active
  judging
  finished
  cancelled
}

enum RegistrationMode {
  internal
  external
}

enum ReviewStatus {
  pending
  approved
  waitlisted
  rejected
}

model HackathonRegistration {
  id           String             @id @default(uuid())
  hackathonId  String             @map("hackathon_id")
  userId       String             @map("user_id")
  status       RegistrationStatus @default(registered)
  registeredAt DateTime           @default(now()) @map("registered_at")
  checkedInAt  DateTime?          @map("checked_in_at")
  answers      Json?
  formSnapshot Json?              @map("form_snapshot")
  reviewStatus ReviewStatus       @default(pending) @map("review_status")
  reviewNote   String?            @map("review_note") @db.Text
  reviewedAt   DateTime?          @map("reviewed_at")
  reviewedById String?            @map("reviewed_by_id")
  // 软删：用户取消报名走 deletedAt, 保留审计
  deletedAt    DateTime?          @map("deleted_at")

  hackathon  Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("HackathonRegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([hackathonId, userId])
  @@index([userId, status])
  @@index([hackathonId, status])
  @@index([reviewStatus])
  @@map("hackathon_registrations")
}

